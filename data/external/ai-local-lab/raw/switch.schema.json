{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-local-lab.com/data/releases/v1.8.0/switch.schema.json",
  "title": "ai-local-lab switch session",
  "version": "1.1.0",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "device": {
      "type": "string"
    },
    "measured_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "context": {
      "type": "object",
      "properties": {
        "execution": {
          "type": "string",
          "enum": [
            "on-device",
            "on-host"
          ]
        },
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "power_mode": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "id": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "name"
          ],
          "additionalProperties": false
        },
        "background_services": {
          "type": "object",
          "properties": {
            "checked_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enabled_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "active_before": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "enabled_after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "active_after": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "checked_count",
            "enabled_before",
            "active_before",
            "enabled_after",
            "active_after"
          ],
          "additionalProperties": false
        },
        "notes": {
          "type": "string"
        },
        "script_digest": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "enum": [
                "md5",
                "sha256"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "algorithm",
            "value"
          ],
          "additionalProperties": false
        },
        "source_refs": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "raw_log",
                  "benchmark",
                  "measurement_note",
                  "spec_analysis",
                  "legacy_analysis"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "public_path": {
                "type": "string",
                "pattern": "^content\\/[A-Za-z0-9._/-]+$"
              },
              "benchmark_id": {
                "type": "string"
              },
              "raw_available": {
                "type": "boolean"
              }
            },
            "required": [
              "kind",
              "id",
              "raw_available"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "execution",
        "runtime",
        "source_refs"
      ],
      "additionalProperties": false
    },
    "runs": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9.-]+$"
          },
          "scenario": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "escalation",
                  "coexist"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "pair": {
            "type": "object",
            "properties": {
              "a": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quant": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "model",
                  "tag",
                  "quant"
                ],
                "additionalProperties": false
              },
              "b": {
                "type": "object",
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "tag": {
                    "type": "string",
                    "minLength": 1
                  },
                  "quant": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "model",
                  "tag",
                  "quant"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "a",
              "b"
            ],
            "additionalProperties": false
          },
          "mode": {
            "type": "string",
            "enum": [
              "default",
              "force_cold"
            ]
          },
          "cycles": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "planned_attempts": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "protocol": {
            "type": "object",
            "properties": {
              "num_predict": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "temperature": {
                "type": "number"
              },
              "keep_alive": {
                "type": "number"
              }
            },
            "required": [
              "num_predict",
              "temperature"
            ],
            "additionalProperties": false
          },
          "capture": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "enum": [
                  "native",
                  "legacy_backfill"
                ]
              },
              "complete": {
                "type": "boolean"
              }
            },
            "required": [
              "method",
              "complete"
            ],
            "additionalProperties": false
          },
          "attempts": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "attempt_index": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cycle": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "protocol_from_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to_model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "const": "ok"
                    },
                    "load_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "total_ms": {
                      "type": "number",
                      "minimum": 0
                    },
                    "residency": {
                      "type": "object",
                      "properties": {
                        "capture": {
                          "type": "string",
                          "enum": [
                            "observed",
                            "unavailable"
                          ]
                        },
                        "evicted": {
                          "type": "boolean"
                        },
                        "both_resident": {
                          "type": "boolean"
                        },
                        "resident_before_tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "resident_after_tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "capture"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "attempt_index",
                    "cycle",
                    "protocol_from_tag",
                    "to_tag",
                    "to_model",
                    "status",
                    "load_ms",
                    "total_ms",
                    "residency"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "attempt_index": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "cycle": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "protocol_from_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to_tag": {
                      "type": "string",
                      "minLength": 1
                    },
                    "to_model": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "type": "string",
                      "const": "failed"
                    },
                    "error": {
                      "type": "object",
                      "properties": {
                        "stage": {
                          "type": "string",
                          "enum": [
                            "resident_probe",
                            "force_unload",
                            "timed_load",
                            "post_probe",
                            "unknown"
                          ]
                        },
                        "kind": {
                          "type": "string",
                          "enum": [
                            "http_error",
                            "timeout",
                            "connection_error",
                            "other"
                          ]
                        },
                        "message": {
                          "type": "string",
                          "minLength": 1
                        },
                        "http_status": {
                          "type": "integer",
                          "minimum": -9007199254740991,
                          "maximum": 9007199254740991
                        },
                        "server_error": {
                          "type": "string",
                          "maxLength": 8192
                        }
                      },
                      "required": [
                        "stage",
                        "kind",
                        "message"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "attempt_index",
                    "cycle",
                    "protocol_from_tag",
                    "to_tag",
                    "to_model",
                    "status",
                    "error"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "derived_counts": {
            "type": "object",
            "properties": {
              "planned_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "observed_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "success_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "failure_count": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "unobserved_attempts": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "planned_attempts",
              "observed_attempts",
              "success_count",
              "failure_count",
              "unobserved_attempts"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "scenario",
          "pair",
          "mode",
          "cycles",
          "planned_attempts",
          "protocol",
          "capture",
          "attempts",
          "derived_counts"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "device",
    "measured_at",
    "context",
    "runs"
  ],
  "additionalProperties": false
}
